{
    "name": "@diphyx/icons",
    "version": "1.3.1",
    "description": "A set of icons for DiPhyx projects - Iconify compatible",
    "type": "module",
    "main": "./icons/icons.json",
    "exports": {
        ".": "./icons/icons.json",
        "./svg/*": "./icons/*.svg",
        "./json": "./icons/icons.json"
    },
    "files": [
        "icons",
        "assets"
    ],
    "keywords": [
        "icons",
        "iconify",
        "diphyx",
        "svg"
    ],
    "scripts": {
        "build": "tsx build.ts",
        "type-check": "tsc --noEmit"
    },
    "author": "DiPhyx Team",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/diphyx/icons"
    },
    "devDependencies": {
        "@iconify/tools": "^4.2.0",
        "@types/node": "^24.13.3",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "consola": "^3.4.2"
    }
}
